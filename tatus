[32m+[m
[32m+[m[32m        $pdo = Database::getInstance()->getConnection();[m
[32m+[m
[32m+[m[32m        // --- Step 2: start transaction, lock book row FOR UPDATE ---[m
[32m+[m[32m        $startedTx = false;[m
[32m+[m[32m        try {[m
[32m+[m[32m            $pdo->beginTransaction();[m
[32m+[m[32m            $startedTx = true;[m
[32m+[m
[32m+[m[32m            $stmt = $pdo->prepare('SELECT * FROM books WHERE book_id = ? FOR UPDATE');[m
[32m+[m[32m            $stmt->execute([$bookId]);[m
[32m+[m[32m            $book = $stmt->fetch(PDO::FETCH_ASSOC);[m
[32m+[m[32m            if (!$book) {[m
[32m+[m[32m                throw new NotFoundException('Book not found.');[m
[32m+[m[32m            }[m
[32m+[m
[32m+[m[32m            // --- Step 3: business rule checks (order matters to give a clear error first) ---[m
[32m+[m
[32m+[m[32m            // 3a. Member exists (Member::find throws NotFoundException if missing) and is active.[m
[32m+[m[32m            $member = Member::find($memberId);[m
[32m+[m[32m            if (!Member::isActive($memberId)) {[m
[32m+[m[32m                throw new BusinessRuleException('This member is inactive and cannot borrow books.');[m
[32m+[m[32m            }[m
[32m+[m
[32m+[m[32m            // 3b. Book has at least 1 available copy right now (freshly locked row).[m
[32m+[m[32m            if ((int) $book['available_copies'] < 1) {[m
[32m+[m[32m                throw new BusinessRuleException('No copies of this book are available right now.');[m
[32m+[m[32m            }[m
[32m+[m
[32m+[m[32m            // 3c. Member has no unpaid fines.[m
[32m+[m[32m            if (Fine::hasUnpaid($memberId)) {[m
[32m+[m[32m                throw new BusinessRuleException("Clear the member's unpaid fines first.");[m
[32m+[m[32m            }[m
[32m+[m
[32m+[m[32m            // 3d. Member has fewer than MAX_LOANS active (unreturned) loans already.[m
[32m+[m[32m            if (Member::countActiveLoans($memberId) >= MAX_LOANS) {[m
[32m+[m[32m                throw new BusinessRuleException([m
[32m+[m[32m                    'This member already has ' . MAX_LOANS . ' active loans. Return a book first.'[m
[32m+[m[32m                );[m
[32m+[m[32m            }[m
[32m+[m
[32m+[m[32m            // 3e. Member does NOT already hold an unreturned copy of this exact book.[m
[32m+[m[32m            $dup = $pdo->prepare([m
[32m+[m[32m                'SELECT 1 FROM loans[m
[32m+[m[32m                  WHERE member_id = ? AND book_id = ? AND return_date IS NULL[m
[32m+[m[32m                  LIMIT 1'[m
[32m+[m[32m            );[m
[32m+[m[32m            $dup->execute([$memberId, $bookId]);[m
[32m+[m[32m            if ($dup->fetchColumn() !== false) {[m
[32m+[m[32m                throw new BusinessRuleException([m
[32m+[m[32m                    'This member already has an unreturned copy of this book.'[m
[32m+[m[32m                );[m
[32m+[m[32m            }[m
[32m+[m
[32m+[m[32m            // --- Step 4: decrement available, insert loan row ---[m
[32m+[m[32m            Book::decrementAvailable($bookId);[m
[32m+[m
[32m+[m[32m            $todayObj = new DateTime('today');[m
[32m+[m[32m            $dueObj   = clone $todayObj;[m
[32m+[m[32m            $dueObj->modify('+' . LOAN_DAYS . ' days');[m
[32m+[m
[32m+[m[32m            $insert = $pdo->prepare([m
[32m+[m[32m                'INSERT INTO loans (book_id, member_id, librarian_id, issue_date, due_date, return_date, status)[m
[32m+[m[32m                 VALUES (?, ?, ?, ?, ?, NULL, ?)'[m
[32m+[m[32m            );[m
[32m+[m[32m            $insert->execute([[m
[32m+[m[32m                $bookId,[m
[32m+[m[32m                $memberId,[m
[32m+[m[32m                $librarianId,[m
[32m+[m[32m                $todayObj->format('Y-m-d'),[m
[32m+[m[32m                $dueObj->format('Y-m-d'),[m
[32m+[m[32m                'borrowed',[m
[32m+[m[32m            ]);[m
