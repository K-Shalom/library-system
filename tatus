[32m+[m[32m    /**[m
[32m+[m[32m     * Return a loan transactionally.[m
[32m+[m[32m     *[m
[32m+[m[32m     * Locks the loan row, sets return_date + status, increments the book's available copies,[m
[32m+[m[32m     * calculates the overdue fine, and (if > 0) creates a fine record.[m
[32m+[m[32m     *[m
[32m+[m[32m     * @param mixed $loanId  Positive integer loan_id[m
[32m+[m[32m     * @return array  ['loan_id' => int, 'days_late' => int, 'fine' => float][m
[32m+[m[32m     *[m
[32m+[m[32m     * @throws ValidationException  bad id[m
[32m+[m[32m     * @throws NotFoundException    loan not found[m
[32m+[m[32m     * @throws BusinessRuleException loan already returned, or fine > 0 but Fine::create failed[m
[32m+[m[32m     */[m
[32m+[m[32m    public static function return($loanId): array[m
[32m+[m[32m    {[m
[32m+[m[32m        $loanId = self::validateId($loanId, 'Loan ID');[m
[32m+[m[32m        $pdo    = Database::getInstance()->getConnection();[m
[32m+[m
[32m+[m[32m        $startedTx = false;[m
[32m+[m[32m        try {[m
[32m+[m[32m            $pdo->beginTransaction();[m
[32m+[m[32m            $startedTx = true;[m
[32m+[m
[32m+[m[32m            // --- Step 1: lock the loan row; throw if missing or already returned ---[m
[32m+[m[32m            $stmt = $pdo->prepare('SELECT * FROM loans WHERE loan_id = ? FOR UPDATE');[m
[32m+[m[32m            $stmt->execute([$loanId]);[m
[32m+[m[32m            $loan = $stmt->fetch(PDO::FETCH_ASSOC);[m
[32m+[m[32m            if (!$loan) {[m
[32m+[m[32m                throw new NotFoundException('Loan not found.');[m
[32m+[m[32m            }[m
[32m+[m[32m            if ($loan['return_date'] !== null && $loan['return_date'] !== '') {[m
[32m+[m[32m                throw new BusinessRuleException('This book was already returned.');[m
[32m+[m[32m            }[m
[32m+[m
[32m+[m[32m            // --- Step 2: update loan return_date/status and increment the book ---[m
[32m+[m[32m            $todayObj     = new DateTime('today');[m
[32m+[m[32m            $todayStr     = $todayObj->format('Y-m-d');[m
[32m+[m[32m            $dueDateStr   = $loan['due_date'];[m
[32m+[m[32m            $bookId       = (int) $loan['book_id'];[m
[32m+[m
[32m+[m[32m            $upd = $pdo->prepare([m
[32m+[m[32m                'UPDATE loans SET return_date = ?, status = ? WHERE loan_id = ?'[m
[32m+[m[32m            );[m
[32m+[m[32m            $upd->execute([$todayStr, 'returned', $loanId]);[m
[32m+[m
[32m+[m[32m            Book::incrementAvailable($bookId);[m
[32m+[m
[32m+[m[32m            // --- Step 3: calculate fine; if > 0 create a fine row ---[m
[32m+[m[32m            $fineAmount = Fine::calculate($dueDateStr, $todayStr);[m
[32m+[m[32m            if ($fineAmount > 0) {[m
[32m+[m[32m                Fine::create($loanId, $fineAmount);[m
[32m+[m[32m            }[m
[32m+[m
[32m+[m[32m            // --- Step 4: commit ---[m
[32m+[m[32m            $pdo->commit();[m
[32m+[m
[32m+[m[32m            $daysLate = 0;[m
[32m+[m[32m            $dueObj   = DateTime::createFromFormat('!Y-m-d', $dueDateStr);[m
[32m+[m[32m            if ($dueObj instanceof DateTime) {[m
[32m+[m[32m                $daysLate = max(0, (int) $dueObj->diff($todayObj)->format('%r%a'));[m
[32m+[m[32m            }[m
[32m+[m[32m            return [[m
[32m+[m[32m                'loan_id'   => $loanId,[m
[32m+[m[32m                'days_late' => $daysLate,[m
[32m+[m[32m                'fine'      => $fineAmount,[m
[32m+[m[32m            ];[m
[32m+[m
[32m+[m[32m        } catch (Throwable $e) {[m
[32m+[m[32m            if ($startedTx && $pdo->inTransaction()) {[m
[32m+[m[32m                $pdo->rollBack();[m
[32m+[m[32m            }[m
[32m+[m[32m            throw $e;[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
