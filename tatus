[32m+[m[32m                       m.full_name AS member_name,[m
[32m+[m[32m                       b.title AS book_title,[m
[32m+[m[32m                       CASE[m
[32m+[m[32m                         WHEN l.due_date < CURDATE() THEN DATEDIFF(CURDATE(), l.due_date)[m
[32m+[m[32m                         ELSE 0[m
[32m+[m[32m                       END AS days_overdue,[m
[32m+[m[32m                       CASE[m
[32m+[m[32m                         WHEN l.due_date < CURDATE() THEN DATEDIFF(CURDATE(), l.due_date) * ?[m
[32m+[m[32m                         ELSE 0[m
[32m+[m[32m                       END AS estimated_fine[m
