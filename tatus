[32m+[m[32m     * @throws ValidationException  if any id is not a positive integer[m
[32m+[m[32m     * @throws NotFoundException    if member or book does not exist[m
[32m+[m[32m     * @throws BusinessRuleException on any rule violation (inactive member, no copies,[m
[32m+[m[32m     *                               unpaid fines, max loans reached, duplicate unreturned loan)[m
[32m+[m[32m     * @throws DatabaseException    on wrapped DB errors (from Database class)[m
[32m+[m[32m     */[m
[32m+[m[32m    public static function borrow($memberId, $bookId, $librarianId): int[m
[32m+[m[32m    {[m
[32m+[m[32m        // --- Step 1: validate IDs as positive integers ---[m
[32m+[m[32m        $memberId    = self::validateId($memberId, 'Member ID');[m
