[32m+[m[32m                 WHERE l.return_date IS NULL[m
[32m+[m[32m                 ORDER BY l.status DESC, l.due_date ASC, l.loan_id DESC";[m
[32m+[m
[32m+[m[32m        $stmt = $pdo->prepare($sql);[m
